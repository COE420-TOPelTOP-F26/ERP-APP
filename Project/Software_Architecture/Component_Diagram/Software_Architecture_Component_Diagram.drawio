geometry"/></mxCell><mxCell id="p1-267" value="Shaded boxes = Lab 5 classes in the component" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontSize=12;fontStyle=0;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2484.0" y="1137.0" width="265.1" height="18" as="geometry"/></mxCell><mxCell id="p1-268" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffdf2;strokeColor=#000000;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="2475" y="1180" width="370" height="184" as="geometry"/></mxCell><mxCell id="p1-269" value="" style="edgeStyle=none;html=1;rounded=0;strokeWidth=1;strokeColor=#000000;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2829" y="1180" as="sourcePoint"/><mxPoint x="2845" y="1196" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p1-270" value="Open layered architecture with partitions" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontSize=13;fontStyle=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2484.0" y="1188.0" width="258.8" height="19" as="geometry"/></mxCell><mxCell id="p1-271" value="A layer only uses lower layers (any lower layer:" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontSize=12;fontStyle=0;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2484.0" y="1209.0" width="255.4" height="18" as="geometry"/></mxCell><mxCell id="p1-272" value="open architecture) and never a higher one." style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontSize=12;fontStyle=0;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2484.0" y="1227.0" width="232.8" height="18" as="geometry"/></mxCell><mxCell id="p1-273" value="Partitions of one layer may serve each other" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontSize=12;fontStyle=0;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2484.0" y="1245.0" width="240.7" height="18" as="geometry"/></mxCell><mxCell id="p1-274" value="(CO3 serves CO4, CO6; CO1 serves CO2)." style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontSize=12;fontStyle=0;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2484.0" y="1263.0" width="238.0" height="18" as="geometry"/></mxCell><mxCell id="p1-275" value="Dependencies point one way, no cycles:" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontSize=12;fontStyle=0;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2484.0" y="1281.0" width="219.2" height="18" as="geometry"/></mxCell><mxCell id="p1-276" value="CO5 → CO3, CO6, CO2, CO1" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontSize=12;fontStyle=0;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2484.0" y="1299.0" width="168.0" height="18" as="geometry"/></mxCell><mxCell id="p1-277" value="CO4 → CO3, CO2, CO1;  CO6 → CO3, CO2, CO1" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontSize=12;fontStyle=0;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2484.0" y="1317.0" width="277.3" height="18" as="geometry"/></mxCell><mxCell id="p1-278" value="CO3 → CO2, CO1;  CO2 → CO1" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontSize=12;fontStyle=0;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2484.0" y="1335.0" width="183.3" height="18" as="geometry"/></mxCell><mxCell id="p1-279" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffdf2;strokeColor=#000000;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="2475" y="1378" width="370" height="148" as="geometry"/></mxCell><mxCell id="p1-280" value="" style="edgeStyle=none;html=1;rounded=0;strokeWidth=1;strokeColor=#000000;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2829" y="1378" as="sourcePoint"/><mxPoint x="2845" y="139